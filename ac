
name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract and locate project
        run: |
          for f in *.zip; do
            if [ -f "$f" ]; then
              unzip -oq "$f" -d extracted
            fi
          done

          SETTINGS=$(find . -name settings.gradle.kts -print -quit)

          if [ -z "$SETTINGS" ]; then
            echo "Android project files not found"
            exit 1
          fi

          ROOT=$(dirname "$SETTINGS")
          echo "PROJECT_ROOT=$ROOT" >> $GITHUB_ENV

      - name: Build APK
        run: gradle -p "$PROJECT_ROOT" :app:assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: AutoDialer-APK
          path: ${{ env.PROJECT_ROOT }}/app/build/outputs/apk/debug/app-debug.apk
